{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Pytest (Feature Engineer Test)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "ml/tests/test_ml_pipeline.py",
                "-k",
                "test_feature_engineer_transformation"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python Debugger: Pytest (All ML Tests)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "ml/tests"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}