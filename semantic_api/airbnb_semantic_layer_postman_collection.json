          "raw": "{\n  \"metrics\": [\"total_revenue\", \"booking_conversion_rate\"],\n  \"dimensions\": [\"city\"],\n  \"time_dimension\": \"booking_date\",\n  \"time_grain\": \"month\",\n  \"filters\": {\n    \"country\": \"USA\"\n  },\n  \"limit\": 50\n}"
